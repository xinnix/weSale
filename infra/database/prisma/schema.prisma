generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 管理端用户模型 (Admin)
// ============================================
model Admin {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  avatar        String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // 关联
  refreshTokens AdminRefreshToken[]
  roles         AdminRole[]
  agentCreatedBy Agent[] @relation("AgentCreatedBy")
  agentUpdatedBy Agent[] @relation("AgentUpdatedBy")
  wecomConfigCreatedBy WecomConfig[] @relation("WecomConfigCreatedBy")
  wecomConfigUpdatedBy WecomConfig[] @relation("WecomConfigUpdatedBy")
  productCreatedBy Product[] @relation("ProductCreatedBy")
  productUpdatedBy Product[] @relation("ProductUpdatedBy")
  liveCodesCreatedBy LiveCode[] @relation("LiveCodeCreatedBy")

  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("admins")
}

// ============================================
// 小程序用户模型 (User)
// ============================================
model User {
  id           String  @id @default(cuid())
  username     String? @unique // 可空：微信顾客静默注册时无用户名
  email        String? // 可选字段（微信用户不需要）
  passwordHash String? // 可空：微信登录用户无密码

  // 微信相关字段
  openid     String? @unique // 微信用户唯一标识
  unionid    String? @unique // 开放平台标识（可选）
  sessionKey String? // 会话密钥（加密存储）

  phone       String?
  avatar      String?
  nickname    String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // 关联
  refreshTokens UserRefreshToken[]
  addresses     Address[]
  orders        Order[]
  contacts      Contact[]

  @@index([openid])
  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("users")
}

// ============================================
// 角色模型 (仅用于 Admin)
// ============================================
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  level       Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // 关联
  permissions RolePermission[]
  admins      AdminRole[]

  @@index([slug])
  @@index([deletedAt])
  @@map("roles")
}

// ============================================
// 权限模型
// ============================================
model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  // 关联
  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([deletedAt])
  @@map("permissions")
}

// ============================================
// Admin 角色关联
// ============================================
model AdminRole {
  id         String   @id @default(cuid())
  adminId    String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  // 关联
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, roleId])
  @@index([adminId])
  @@index([roleId])
  @@map("admin_roles")
}

// ============================================
// 角色权限关联
// ============================================
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // 关联
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================
// Admin 刷新令牌
// ============================================
model AdminRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  // 关联
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
  @@map("admin_refresh_tokens")
}

// ============================================
// User 刷新令牌
// ============================================
model UserRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  // 关联
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_refresh_tokens")
}

// ============================================
// Dify Agent 模型
// ============================================
model Agent {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  difyApiUrl  String   @default("https://api.dify.ai/v1")
  difyApiKey  String
  difyAppType String   @default("agent")
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Admin? @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("AgentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([isActive])
  @@map("agents")
}

// ============================================
// 企业微信应用配置 (WecomConfig)
// ============================================
model WecomConfig {
  id             String   @id @default(cuid())
  name           String
  corpId         String
  agentId        Int
  secret         String
  token          String
  encodingAESKey String
  description    String?
  memberUserids  Json     @default("[]") // 接待成员白名单（企微 userid[]），侧边栏登录校验
  isActive       Boolean  @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联
  messages  WecomMessage[]
  events    WecomEvent[]
  createdBy Admin? @relation("WecomConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("WecomConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([corpId, agentId])
  @@index([corpId])
  @@index([isActive])
  @@map("wecom_configs")
}

// ============================================
// 企业微信消息记录 (WecomMessage)
// ============================================
model WecomMessage {
  id        String   @id @default(cuid())
  configId  String
  direction String
  msgType   String
  fromUser  String?
  toUser    String?
  content   String?
  rawXml    String?
  createdAt DateTime @default(now())

  config WecomConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([createdAt])
  @@map("wecom_messages")
}

// ============================================
// 企业微信事件记录 (WecomEvent)
// ============================================
model WecomEvent {
  id        String   @id @default(cuid())
  configId  String
  eventType String
  eventKey  String?
  fromUser  String?
  content   String?
  rawXml    String?
  createdAt DateTime @default(now())

  config WecomConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([eventType])
  @@index([createdAt])
  @@map("wecom_events")
}

// ============================================
// 销售系统核心枚举
// ============================================
enum IntentLevel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CLOSING
}

enum ContactStatus {
  ACTIVE
  CONVERTED
  ESCALATED
  ARCHIVED
}

enum LiveCodeStatus {
  ACTIVE
  DISABLED
}

// 意图分类（与 IntentLevel 强度正交：一个表"问什么"，一个表"多强"）
enum IntentCategory {
  USAGE_CONSULTATION // 使用咨询
  OBJECTION_PRICE // 价格异议
  SAFETY_CONCERN // 安全顾虑
  COMPLAINT // 投诉
  GENERAL // 一般
}

// 三策略（F4.4）
enum CopilotStrategy {
  A_RATIONAL // 理性/科普
  B_EMOTIONAL // 感性/逼单
  C_UPSELL // 搭售/升级
}

enum SessionState {
  GREETING
  NEEDS_DISCOVERY
  PRODUCT_MATCH
  OBJECTION_HANDLING
  CLOSING
  CONVERTED
  ESCALATED
  TIMED_OUT
}

enum MessageRole {
  user
  assistant
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  VIDEO
  FILE
  LOCATION
  LINK_CARD
  MINIPROGRAM
  MENU
  BUSINESS_CARD
  EVENT
  SYSTEM_NOTE
}

enum MessageOrigin {
  CUSTOMER
  SYSTEM
  SERVICER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME
  LIFETIME
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  REFUNDING
  REFUNDED
  CANCELLED
}

enum OrderSource {
  KF_SESSION // 微信客服会话（AI 逼单建单）
  MINIAPP // 小程序商城自主下单
  ADMIN_MANUAL // 管理后台手工创建
}

// ============================================
// 访客档案 (Contact)
// ============================================
model Contact {
  id              String        @id @default(cuid())
  openId          String        @unique @map("open_id")
  unionId         String?       @map("union_id")
  userId          String?       @map("user_id") // OneID 关联：与小程序 User 打通（订单归并反写）
  externalUserId  String?       @unique @map("external_user_id") // 企微好友 external_userid（与 KF openId 同体系）
  nickname        String?
  avatarUrl       String?       @map("avatar_url")
  phone           String?
  status          ContactStatus @default(ACTIVE)
  intentLevel     IntentLevel   @default(UNKNOWN) @map("intent_level")
  utmSource       String?       @map("utm_source")
  utmMedium       String?       @map("utm_medium")
  utmCampaign     String?       @map("utm_campaign")
  utmContent      String?       @map("utm_content")
  firstActiveAt   DateTime      @default(now()) @map("first_active_at")
  lastActiveAt    DateTime      @default(now()) @map("last_active_at")
  convertedAt     DateTime?     @map("converted_at")
  paidAmountFen   Int?          @map("paid_amount_fen")
  pointsBalance   Int           @default(0) @map("points_balance") // 积分余额（PointsLedger 流水驱动）
  tags            Json          @default("[]") // 语义标签 [{name,source,refId,at}]，双写 SSOT
  metadata        Json? // 公域订单属性 / 活码归因缓存
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  sessions        ConversationSession[]
  orders          Order[]
  ledgers         PointsLedger[]
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([intentLevel])
  @@index([lastActiveAt])
  @@index([utmSource])
  @@index([userId])
  @@index([externalUserId])
  @@map("contacts")
}

// ============================================
// 积分流水 (PointsLedger) —— 幂等记账，积分的唯一事实源
// ============================================
model PointsLedger {
  id             String   @id @default(cuid())
  contactId      String   @map("contact_id")
  delta          Int // 入账 +n / 扣减 -n（权益兑换）
  balanceAfter   Int      @map("balance_after") // 该笔后的余额快照
  reason         String // 人类可读：'注册欢迎积分' / '订单奖励'
  reasonCode     String // 程序枚举：REGISTER_WELCOME / ORDER_PAID / ORDER_REDEEM
  refUserId      String?  @map("ref_user_id") // 注册路径关联 User
  refOrderId     String?  @map("ref_order_id") // 订单奖励 / 权益订单
  refLiveCodeId  String?  @map("ref_live_code_id")
  idempotencyKey String   @unique @map("idempotency_key") // ${reasonCode}:${业务键}，防回调重放
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([reasonCode])
  @@index([refOrderId])
  @@index([createdAt])
  @@map("points_ledgers")
}

// ============================================
// 发送事件流水 (SendEvent) —— 侧边栏采纳率 + 合规审计（开放问题 #8）
// 侧边栏走企微 JS-SDK 客户端发送，后端不经手 → 独立轻量流水
// ============================================
model SendEvent {
  id              String           @id @default(cuid())
  memberUserId    String           @map("member_user_id") // 企微成员 userid
  corpId          String           @map("corp_id")
  externalUserId  String           @map("external_user_id") // 客户
  contactId       String?          @map("contact_id")
  generationId    String?          @map("generation_id") // 关联哪次生成
  strategy        CopilotStrategy? // 采纳的策略
  msgType         String           @map("msg_type") // text | miniprogram
  adopted         Boolean          @default(true) // 复制视为弱采纳（false）
  contentSnapshot String?          @db.Text @map("content_snapshot")
  sentAt          DateTime         @default(now()) @map("sent_at")

  @@index([memberUserId])
  @@index([contactId])
  @@index([generationId])
  @@index([sentAt])
  @@map("send_events")
}

// ============================================
// 对话会话 (ConversationSession)
// ============================================
model ConversationSession {
  id              String        @id @default(cuid())
  contactId       String        @map("contact_id")
  openKfId        String        @map("open_kf_id")
  sessionKey      String        @unique @map("session_key")
  state           SessionState  @default(GREETING)
  intentLevel     IntentLevel   @default(UNKNOWN) @map("intent_level")
  turnCount       Int           @default(0) @map("turn_count")
  lastActiveAt    DateTime      @default(now()) @map("last_active_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  contact         Contact       @relation(fields: [contactId], references: [id])
  messages        ConversationMessage[]
  orders          Order[]

  @@index([contactId])
  @@index([openKfId])
  @@index([state])
  @@index([lastActiveAt])
  @@map("conversation_sessions")
}

// ============================================
// 对话消息 (ConversationMessage)
// ============================================
model ConversationMessage {
  id                    String        @id @default(cuid())
  sessionId             String        @map("session_id")
  role                  MessageRole
  type                  MessageType   @default(TEXT)
  origin                MessageOrigin @default(CUSTOMER)
  content               String        @db.Text
  kfMsgId               String?       @unique @map("kf_msg_id")
  openKfId              String?       @map("open_kf_id")
  externalUserId        String?       @map("external_user_id")
  servicerUserId        String?       @map("servicer_user_id")
  sendTime              DateTime?     @map("send_time")
  aiIntentLevel         IntentLevel?  @map("ai_intent_level")
  aiConfidence          Float?        @map("ai_confidence")
  sendPaymentCard       Boolean       @default(false) @map("send_payment_card")
  recommendedProductId  String?       @map("recommended_product_id")
  escalationReason      String?       @map("escalation_reason")
  internalNote          String?       @db.Text @map("internal_note")
  createdAt             DateTime      @default(now()) @map("created_at")

  session               ConversationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([role])
  @@index([origin])
  @@index([openKfId])
  @@index([externalUserId])
  @@index([sendTime])
  @@index([createdAt])
  @@map("conversation_messages")
}

// ============================================
// KF 消息同步游标 (KfSyncCursor)
// ============================================
model KfSyncCursor {
  id        String   @id @default(cuid())
  openKfId  String   @unique @map("open_kf_id")
  cursor    String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kf_sync_cursors")
}

// ============================================
// 产品模型 (Product)
// ============================================
model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  description       String?       @db.Text
  shortDescription  String?       @db.Text @map("short_description")
  coverImage        String?       @map("cover_image")
  images            String[]      @default([])
  category          String?
  priceFen          Int           @map("price_fen")
  originalPriceFen  Int?          @map("original_price_fen")
  billingCycle      BillingCycle  @default(ONE_TIME) @map("billing_cycle")
  features          Json          @default("[]")
  trialDays         Int?          @map("trial_days")
  status            ProductStatus @default(DRAFT)
  sort              Int           @default(0)
  createdById       String?       @map("created_by_id")
  updatedById       String?       @map("updated_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  createdBy Admin?  @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin?  @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  orders    Order[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([deletedAt])
  @@map("products")
}

// ============================================
// 订单模型 (Order)
// ============================================
model Order {
  id                String      @id @default(cuid())
  orderNo           String      @unique @map("order_no")
  source            OrderSource @default(KF_SESSION)
  contactId         String?     @map("contact_id") // 可空：小程序自主下单无客服 Contact
  userId            String?     @map("user_id") // 小程序下单用户
  productId         String      @map("product_id")
  sessionId         String?     @map("session_id")
  quantity          Int         @default(1)
  unitPriceFen      Int         @map("unit_price_fen")
  totalAmountFen    Int         @map("total_amount_fen")
  status            OrderStatus @default(PENDING)
  addressSnapshot   Json? // 下单时收货地址快照（防地址后续被改）
  shipCompany       String?     @map("ship_company") // 物流公司（SHIPPED 后填写）
  shipNo            String?     @map("ship_no") // 物流单号
  expireAt          DateTime?   @map("expire_at") // 支付截止时间（超时关单用）
  paidAt            DateTime?   @map("paid_at")
  paidTransactionId String?     @map("paid_transaction_id")
  refundedAt        DateTime?   @map("refunded_at")
  refundAmountFen   Int?        @map("refund_amount_fen")
  refundReason      String?     @map("refund_reason")
  metadata          Json?
  createdById       String?     @map("created_by_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  contact  Contact?             @relation(fields: [contactId], references: [id])
  user     User?                @relation(fields: [userId], references: [id])
  product  Product              @relation(fields: [productId], references: [id])
  session  ConversationSession? @relation(fields: [sessionId], references: [id])

  @@index([contactId])
  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([orderNo])
  @@index([createdAt])
  @@map("orders")
}

// ============================================
// 企微「联系我」活码 (LiveCode) —— F8 站外获客
// ============================================
model LiveCode {
  id                 String         @id @default(cuid())
  name               String
  state              String         @unique // ≤30 字节短码：lc_ + 6 位 base36（DB 内映射渠道）
  contactWayConfigId String         @map("contact_way_config_id") // add_contact_way 返回的 config_id
  qrUrl              String         @map("qr_url") // 企微生成的联系我二维码 URL
  memberUserids      Json           @default("[]") // 接待成员 userid[]（企微行为：多人随机分配）
  autoTags           Json           @default("[]") // [{name, tagId?}] add_contact_way 自动打标签规则
  status             LiveCodeStatus @default(ACTIVE)
  createdById        String?        @map("created_by_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  createdBy          Admin?         @relation("LiveCodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdById])
  @@map("live_codes")
}

// ============================================
// 收货地址 (Address) —— 小程序商城实物商品
// ============================================
model Address {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  receiver  String
  phone     String
  province  String
  city      String
  district  String
  detail    String    @db.VarChar(255)
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ============================================
// Landing 页访问统计 (LandingPageView)
// ============================================
model LandingPageView {
  id         String   @id @default(cuid())
  path       String   @db.VarChar(255)
  referrer   String?  @db.VarChar(512)
  utmSource  String?  @db.VarChar(128) @map("utm_source")
  utmMedium  String?  @db.VarChar(128) @map("utm_medium")
  utmCampaign String? @db.VarChar(128) @map("utm_campaign")
  sessionId  String?  @db.VarChar(64) @map("session_id")
  userAgent  String?  @db.VarChar(512) @map("user_agent")
  ipHash     String?  @db.VarChar(64) @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
  @@map("landing_page_views")
}

