generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 管理端用户模型 (Admin)
// ============================================
model Admin {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  avatar        String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // 关联
  refreshTokens AdminRefreshToken[]
  roles         AdminRole[]
  agentCreatedBy Agent[] @relation("AgentCreatedBy")
  agentUpdatedBy Agent[] @relation("AgentUpdatedBy")
  wecomConfigCreatedBy WecomConfig[] @relation("WecomConfigCreatedBy")
  wecomConfigUpdatedBy WecomConfig[] @relation("WecomConfigUpdatedBy")

  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("admins")
}

// ============================================
// 小程序用户模型 (User)
// ============================================
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String? // 可选字段（微信用户不需要）
  passwordHash String

  // 微信相关字段
  openid     String? @unique // 微信用户唯一标识
  unionid    String? @unique // 开放平台标识（可选）
  sessionKey String? // 会话密钥（加密存储）

  phone       String?
  avatar      String?
  nickname    String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // 关联
  refreshTokens UserRefreshToken[]

  @@index([openid])
  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("users")
}

// ============================================
// 角色模型 (仅用于 Admin)
// ============================================
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  level       Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // 关联
  permissions RolePermission[]
  admins      AdminRole[]

  @@index([slug])
  @@index([deletedAt])
  @@map("roles")
}

// ============================================
// 权限模型
// ============================================
model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  // 关联
  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([deletedAt])
  @@map("permissions")
}

// ============================================
// Admin 角色关联
// ============================================
model AdminRole {
  id         String   @id @default(cuid())
  adminId    String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  // 关联
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, roleId])
  @@index([adminId])
  @@index([roleId])
  @@map("admin_roles")
}

// ============================================
// 角色权限关联
// ============================================
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // 关联
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================
// Admin 刷新令牌
// ============================================
model AdminRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  // 关联
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
  @@map("admin_refresh_tokens")
}

// ============================================
// User 刷新令牌
// ============================================
model UserRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  // 关联
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_refresh_tokens")
}

// ============================================
// Dify Agent 模型
// ============================================
model Agent {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  difyApiUrl  String   @default("https://api.dify.ai/v1")
  difyApiKey  String
  difyAppType String   @default("agent")
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Admin? @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("AgentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([isActive])
  @@map("agents")
}

// ============================================
// 企业微信应用配置 (WecomConfig)
// ============================================
model WecomConfig {
  id             String   @id @default(cuid())
  name           String
  corpId         String
  agentId        Int
  secret         String
  token          String
  encodingAESKey String
  description    String?
  isActive       Boolean  @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联
  messages  WecomMessage[]
  events    WecomEvent[]
  createdBy Admin? @relation("WecomConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("WecomConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([corpId, agentId])
  @@index([corpId])
  @@index([isActive])
  @@map("wecom_configs")
}

// ============================================
// 企业微信消息记录 (WecomMessage)
// ============================================
model WecomMessage {
  id        String   @id @default(cuid())
  configId  String
  direction String
  msgType   String
  fromUser  String?
  toUser    String?
  content   String?
  rawXml    String?
  createdAt DateTime @default(now())

  config WecomConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([createdAt])
  @@map("wecom_messages")
}

// ============================================
// 企业微信事件记录 (WecomEvent)
// ============================================
model WecomEvent {
  id        String   @id @default(cuid())
  configId  String
  eventType String
  eventKey  String?
  fromUser  String?
  content   String?
  rawXml    String?
  createdAt DateTime @default(now())

  config WecomConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([eventType])
  @@index([createdAt])
  @@map("wecom_events")
}

// ============================================
// 销售系统核心枚举
// ============================================
enum IntentLevel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CLOSING
}

enum ContactStatus {
  ACTIVE
  CONVERTED
  ESCALATED
  ARCHIVED
}

enum SessionState {
  GREETING
  NEEDS_DISCOVERY
  PRODUCT_MATCH
  OBJECTION_HANDLING
  CLOSING
  CONVERTED
  ESCALATED
  TIMED_OUT
}

enum MessageRole {
  user
  assistant
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  VIDEO
  FILE
  LOCATION
  LINK_CARD
  MINIPROGRAM
  MENU
  BUSINESS_CARD
  EVENT
  SYSTEM_NOTE
}

enum MessageOrigin {
  CUSTOMER
  SYSTEM
  SERVICER
}

// ============================================
// 访客档案 (Contact)
// ============================================
model Contact {
  id              String        @id @default(cuid())
  openId          String        @unique @map("open_id")
  unionId         String?       @map("union_id")
  nickname        String?
  avatarUrl       String?       @map("avatar_url")
  phone           String?
  status          ContactStatus @default(ACTIVE)
  intentLevel     IntentLevel   @default(UNKNOWN) @map("intent_level")
  utmSource       String?       @map("utm_source")
  utmMedium       String?       @map("utm_medium")
  utmCampaign     String?       @map("utm_campaign")
  utmContent      String?       @map("utm_content")
  firstActiveAt   DateTime      @default(now()) @map("first_active_at")
  lastActiveAt    DateTime      @default(now()) @map("last_active_at")
  convertedAt     DateTime?     @map("converted_at")
  paidAmountFen   Int?          @map("paid_amount_fen")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  sessions        ConversationSession[]

  @@index([status])
  @@index([intentLevel])
  @@index([lastActiveAt])
  @@index([utmSource])
  @@map("contacts")
}

// ============================================
// 对话会话 (ConversationSession)
// ============================================
model ConversationSession {
  id              String        @id @default(cuid())
  contactId       String        @map("contact_id")
  openKfId        String        @map("open_kf_id")
  sessionKey      String        @unique @map("session_key")
  state           SessionState  @default(GREETING)
  intentLevel     IntentLevel   @default(UNKNOWN) @map("intent_level")
  turnCount       Int           @default(0) @map("turn_count")
  lastActiveAt    DateTime      @default(now()) @map("last_active_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  contact         Contact       @relation(fields: [contactId], references: [id])
  messages        ConversationMessage[]

  @@index([contactId])
  @@index([openKfId])
  @@index([state])
  @@index([lastActiveAt])
  @@map("conversation_sessions")
}

// ============================================
// 对话消息 (ConversationMessage)
// ============================================
model ConversationMessage {
  id                    String        @id @default(cuid())
  sessionId             String        @map("session_id")
  role                  MessageRole
  type                  MessageType   @default(TEXT)
  origin                MessageOrigin @default(CUSTOMER)
  content               String        @db.Text
  kfMsgId               String?       @unique @map("kf_msg_id")
  openKfId              String?       @map("open_kf_id")
  externalUserId        String?       @map("external_user_id")
  servicerUserId        String?       @map("servicer_user_id")
  sendTime              DateTime?     @map("send_time")
  aiIntentLevel         IntentLevel?  @map("ai_intent_level")
  aiConfidence          Float?        @map("ai_confidence")
  sendPaymentCard       Boolean       @default(false) @map("send_payment_card")
  recommendedProductId  String?       @map("recommended_product_id")
  escalationReason      String?       @map("escalation_reason")
  internalNote          String?       @db.Text @map("internal_note")
  createdAt             DateTime      @default(now()) @map("created_at")

  session               ConversationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([role])
  @@index([origin])
  @@index([openKfId])
  @@index([externalUserId])
  @@index([sendTime])
  @@index([createdAt])
  @@map("conversation_messages")
}

// ============================================
// KF 消息同步游标 (KfSyncCursor)
// ============================================
model KfSyncCursor {
  id        String   @id @default(cuid())
  openKfId  String   @unique @map("open_kf_id")
  cursor    String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kf_sync_cursors")
}

